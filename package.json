{
  "name": "promptforge",
  "productName": "Decevr's PromptForge",
  "version": "0.1.0",
  "private": true,
  "description": "Decevr's PromptForge is a desktop prompt helper for local ComfyUI image and video models.",
  "author": "Decevr",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check-engine.js",
    "smoke": "electron scripts/smoke-ui.js",
    "pack": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.decevr.promptforge",
    "productName": "Decevr's PromptForge",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": ["nsis", "portable"],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Decevr's PromptForge",
      "uninstallDisplayName": "Decevr's PromptForge",
      "artifactName": "Decevr's PromptForge Setup ${version}.exe"
    },
    "portable": {
      "artifactName": "Decevr's PromptForge.exe"
    }
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  }
}
